# Environment Variables for ChaosRadio
# Copy this file to .env.local and fill in your values

# Auth — the secret key to access the app
ACCESS_KEY=your-secret-key-here

# DeepSeek LLM
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Edge-TTS service (your Vercel deployment)
EDGE_TTS_URL=https://your-edge-tts.vercel.app
EDGE_TTS_TOKEN=
# OpenWeather
OPENWEATHER_API_KEY=your-openweather-key
WEATHER_CITY=Shanghai

# NetEase Cloud Music — your user ID for favorite playlist sync
# Find your UID: open your NCM profile page, the number in the URL is your UID
NCM_USER_ID=
# Your NCM session cookie (required for API access)
# Get from browser after logging into music.163.com
NCM_COOKIE=
